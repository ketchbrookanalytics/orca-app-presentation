// https://github.com/rocker-org/devcontainer-features
{
	"name": "ORCA App Presentation",
	// Minimal Debian base; everything this project needs comes from the
	// features below.
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",

	"features": {
		// Install GitHub CLI
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Install Quarto CLI
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {}
	},

	// Install the shared libraries Quarto's headless Chrome needs, plus Chrome
	// itself. Required for rendering slides/figures to PDF or PNG.
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	// Pass local git, GitHub CLI, and Claude Code credentials to the container
	"mounts": [
      "source=${localEnv:USERPROFILE}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached",
      "source=${localEnv:USERPROFILE}/.config/gh,target=/root/.config/gh,type=bind,consistency=cached",
	  "source=${localEnv:USERPROFILE}/.claude,target=/root/.claude,type=bind,consistency=cached"
    ],

	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"quarto.quarto"
			]
		}
	},

	// Connect as root user. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root"
}
